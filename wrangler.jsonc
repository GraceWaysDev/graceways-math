{
  "name": "graceways-math-trial",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "MATH_DEMO", "class_name": "MathDemo"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["MathDemo"]}],
  "vars": {"PUBLIC_ORIGIN": "https://configure-origin-before-deployment.invalid", "ALLOW_LOCAL_HTTP": "false"},
  "observability": {"enabled": false}
}
